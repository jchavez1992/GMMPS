doc:

# generate man pages for itcl classes
gendoc: 
	(cd  $(srcdir)/library; $(TCLSH) itcldoc [A-Z]*.tcl)

# remove generated man pages
cleandoc:
	rm -f $(srcdir)/man/[A-Z]*.mann



