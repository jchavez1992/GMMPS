# Required Tcl/Tk environment
# Note: the versions and directories below assume Tcl/Tk was build from the tcltk
# source package (tcltk dir in CVS, tcltk-8.4.tar.gz on the skycat ftp server)
# and most likely won't match the layout under /usr (each Linux distribution
# uses a different layout and its not trivial to determine where everything is!)
TCLTK_FILES = \
	bin/wish8.4 \
	lib/tcl8.4/ \
	lib/libtcl8.4.dylib \
	lib/tk8.4/ \
	lib/libtk8.4.dylib \
	lib/blt2.4/ \
	lib/libBLT24.dylib \
	lib/itcl3.3/ \
	lib/itk3.3/ \
	lib/tclx8.4/ \
	lib/iwidgets4.0.1/ \
	lib/Img1.3/

# Generate the binary release for this host type
release: clean-release Darwin-release

clean-release: FORCE
	rm -rf ./release

# On Mac OS X, the skycat install dir contains the complete tcl/tk. 
# Create a standalone Skycat.app directory structure.
darwin-release Darwin-release: skycat-release tcltk-release
	mkdir release/Contents
	mkdir release/Contents/MacOs
	mkdir release/Contents/Resources
	cp mac/skycat.icns release/Contents/Resources
	cp mac/Info.plist release/Contents
	cp mac/PkgInfo release/Contents
	mv release/bin release/Contents/Resources
	mv release/lib release/Contents/Resources
	(cd release/Contents/MacOs; ln -s ../Resources/bin/skycat .)
	rm -f SkycatTmp.dmg
	hdiutil create -megabytes 30 -fs HFS+ -volname Skycat SkycatTmp.dmg
	hdiutil mount SkycatTmp.dmg
	test -d /Volumes/Skycat || exit 1
	rm -rf Skycat.app && mv release Skycat.app
	tar cf - Skycat.app | (cd /Volumes/Skycat; tar xf -)
	hdiutil unmount /Volumes/Skycat/
	rm -f Skycat.dmg
	hdiutil convert -format UDZO SkycatTmp.dmg -o Skycat.dmg
	hdiutil internet-enable -yes Skycat.dmg
	rm -f SkycatTmp.dmg
	mkdir release
	mv Skycat.app Skycat.dmg release

# On Linux, create the source rpm, from which you can create the release rpm
linux-release Linux-release: skycat-src-release skycat-bin-release
	@echo "Please run skycat/linux/make_rpm.sh as root to create the skycat RPMs"

solaris-release SunOS-release: skycat-bin-release
	@echo "Done: The resulting tar file is in `pwd`/release"

hp-release hpux-release HP-UX-release: skycat-bin-release
	@echo "Done: The resulting tar file is in `pwd`/release"

# create a release directory with only the files needed to run skycat
skycat-release: FORCE
	test -d release || mkdir release
	(cd ${exec_prefix}; tar cf - $(SKYCAT_FILES)) | (cd release; tar xf -)

# copy the required tcl/tk files to the release dir
tcltk-release: FORCE
	test -d release || mkdir release
	(cd ${TCL_BIN_DIR}/..; tar cf - $(TCLTK_FILES)) | (cd release; tar xf -)
	find release -type d -name demos -prune -exec rm -rf {} \;

# Make a tar.gz file containing the current, local sources (requires GNU tar)
skycat-src-release:
	test -d release || mkdir release
	rm -rf release/skycat
	mkdir release/skycat
	(cd ..; tar cf - --exclude ./skycat/release .) | (cd release/skycat && tar xf -)
	(cd release/skycat; $(MAKE) distclean)
	find release/skycat -name 'CVS' -prune -exec rm -rf {} \;
	find release/skycat -name '*~' -exec rm -f {} \;
	find release/skycat -name '.cvsignore*' -exec rm -f {} \;
	(cd release/skycat; autoconf)
	(cd release/skycat/tclutil; autoconf)
	(cd release/skycat/astrotcl; autoconf)
	(cd release/skycat/rtd; autoconf)
	(cd release/skycat/cat; autoconf)
	(cd release/skycat/skycat; autoconf)
	mv release/skycat release/skycat-$(PACKAGE_VERSION)
	(cd release; tar czf skycat-$(PACKAGE_VERSION).tar.gz skycat-$(PACKAGE_VERSION))
	rm -rf release/skycat-$(PACKAGE_VERSION)

# Make a tar.gz file containing the current CVS sources (requires GNU tar)
skycat-cvs-release:
	test -d release || mkdir release
	rm -rf release/skycat
	tag=skycat_`echo $(PACKAGE_VERSION) | sed -e 's/\./_/g'` ;\
	(cd $(srcdir)/..; cvs tag -F $$tag .) ;\
	(cd release; cvs export -r $$tag skycat)
	(cd release/skycat; autoconf)
	(cd release/skycat/tclutil; autoconf)
	(cd release/skycat/astrotcl; autoconf)
	(cd release/skycat/rtd; autoconf)
	(cd release/skycat/cat; autoconf)
	(cd release/skycat/skycat; autoconf)
	mv release/skycat release/skycat-$(PACKAGE_VERSION)
	(cd release; tar czf skycat-$(PACKAGE_VERSION).tar.gz skycat-$(PACKAGE_VERSION))
	rm -rf release/skycat-$(PACKAGE_VERSION)

# Make a tar.gz file containing the binary skycat and tcl/tk installation
# Note: The resulting tar file contains the host name. You may want to replace
# it with something more useful, such as "fedora4" or "redhat9".
skycat-bin-release: skycat-release tcltk-release
	rm -rf release/skycat-$(PACKAGE_VERSION)
	mkdir release/skycat-$(PACKAGE_VERSION)
	mv release/lib release/bin release/skycat-$(PACKAGE_VERSION)
	h=`echo $(HOST) | sed -e 's/\..*//'` ;\
	(cd release; tar cf skycat-$(PACKAGE_VERSION)-$$h.tar skycat-$(PACKAGE_VERSION)) ;\
	(cd release; gzip -f skycat-$(PACKAGE_VERSION)-$$h.tar; rm -rf skycat-$(PACKAGE_VERSION))
